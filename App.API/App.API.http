@API_HostAddress = http://localhost:5074


###
# Yeni bir konuşma başlatır (conversationId belirtilmezse otomatik oluşturulur)
POST {{API_HostAddress}}/chat
Content-Type: application/json
Accept: application/json

{
  "message": "Merhaba ben fatih"
}

###
# Var olan bir konuşmaya devam eder (conversationId ile aynı oturumun geçmişi korunur)
POST {{API_HostAddress}}/chat
Content-Type: application/json
Accept: application/json

{
  "message": "Az önce ne sordum?",
  "conversationId": "f3faa96d-a3b8-4054-97d3-4edf768d6aee"
}

###
# Belirtilen konuşmanın mesaj geçmişini getirir
GET {{API_HostAddress}}/chat/f3faa96d-a3b8-4054-97d3-4edf768d6aee/history
Accept: application/json

###
